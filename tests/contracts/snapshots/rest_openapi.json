      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
