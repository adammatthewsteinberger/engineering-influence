{
  "components": {
    "schemas": {
      "BookBriefV1": {
        "additionalProperties": false,
        "properties": {
          "audience": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "budget_micro_usd": {
            "exclusiveMinimum": 0.0,
            "title": "Budget Micro Usd",
            "type": "integer"
          },
          "heat": {
            "anyOf": [
              {
                "enum": [
                  "none",
                  "sweet",
                  "steamy",
                  "explicit"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heat"
          },
          "idea": {
            "minLength": 1,
            "title": "Idea",
            "type": "string"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/RunInputV1"
            },
            "maxItems": 8,
            "title": "Inputs",
            "type": "array"
          },
          "kind": {
            "$ref": "#/components/schemas/BookKind"
          },
          "language": {
            "default": "en",
            "minLength": 1,
            "title": "Language",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "target_words": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Words"
          },
          "title_hint": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title Hint"
          },
          "trim_size": {
            "anyOf": [
              {
                "enum": [
                  "5x8",
                  "5.5x8.5",
                  "6x9"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trim Size"
          },
          "violence": {
            "anyOf": [
              {
                "enum": [
                  "none",
                  "mild",
                  "moderate",
                  "graphic"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Violence"
          }
        },
        "required": [
          "kind",
          "idea",
          "budget_micro_usd"
        ],
        "title": "BookBriefV1",
        "type": "object"
      },
      "BookKind": {
        "enum": [
          "nonfiction",
          "novel",
          "screenplay"
        ],
        "title": "BookKind",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProjectRequest": {
        "additionalProperties": false,
        "properties": {
          "postulates": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Postulates",
            "type": "array"
          },
          "slug": {
            "minLength": 1,
            "title": "Slug",
            "type": "string"
          },
          "stages": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Stages",
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "postulates",
          "stages"
        ],
        "title": "ProjectRequest",
        "type": "object"
      },
      "RunBudgetV1": {
        "properties": {
          "cap_micro_usd": {
            "title": "Cap Micro Usd",
            "type": "integer"
          },
          "remaining_micro_usd": {
            "title": "Remaining Micro Usd",
            "type": "integer"
          },
          "reserved_micro_usd": {
            "title": "Reserved Micro Usd",
            "type": "integer"
          },
          "spent_micro_usd": {
            "title": "Spent Micro Usd",
            "type": "integer"
          }
        },
        "required": [
          "cap_micro_usd",
          "spent_micro_usd",
          "reserved_micro_usd",
          "remaining_micro_usd"
        ],
        "title": "RunBudgetV1",
        "type": "object"
      },
      "RunGrantV1": {
        "additionalProperties": false,
        "properties": {
          "micro_usd": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Micro Usd"
          }
        },
        "title": "RunGrantV1",
        "type": "object"
      },
      "RunInputV1": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "origin": {
            "default": "pasted",
            "enum": [
              "pasted",
              "file"
            ],
            "title": "Origin",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "name",
          "text"
        ],
        "title": "RunInputV1",
        "type": "object"
      },
      "RunIssueV1": {
        "properties": {
          "blocking": {
            "title": "Blocking",
            "type": "boolean"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "code",
          "detail",
          "blocking"
        ],
        "title": "RunIssueV1",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "pending",
          "running",
          "parked_capacity",
          "awaiting_consent",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunSummaryV1": {
        "properties": {
          "artifacts": {
            "items": {
              "type": "string"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "budget": {
            "$ref": "#/components/schemas/RunBudgetV1"
          },
          "consent_requested_micro_usd": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent Requested Micro Usd"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/RunIssueV1"
            },
            "title": "Issues",
            "type": "array"
          },
          "kind": {
            "$ref": "#/components/schemas/BookKind"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "stages": {
            "items": {
              "type": "string"
            },
            "title": "Stages",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "run_id",
          "kind",
          "status",
          "stage",
          "stages",
          "budget",
          "issues",
          "artifacts"
        ],
        "title": "RunSummaryV1",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "engineering-influence",
    "version": "0.1.0rc2"
  },
  "openapi": "3.1.0",
  "paths": {
