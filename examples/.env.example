# Copy to examples/.env and fill in the blanks. Every value is required; none has a default.
# Generate each one with:  openssl rand -hex 24
# Use letters and digits only: the passwords are placed inside connection URLs.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# One or more API keys (comma-separated), each at least 24 characters.
EI_API_KEYS=
# Optional:
# EI_API_PORT=8000
# EI_LOG_LEVEL=INFO
